{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "market_map",
  "position": {
    "x": 20,
    "y": 185,
    "width": 600,
    "height": 330,
    "z": 18,
    "tabOrder": 18
  },
  "visual": {
    "visualType": "map",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_market"
                    }
                  },
                  "Property": "Market_Location"
                }
              },
              "queryRef": "dim_market.Market_Location"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "housing_sales"
                    }
                  },
                  "Property": "Total Records"
                }
              },
              "queryRef": "housing_sales.Total Records"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "housing_sales"
                    }
                  },
                  "Property": "Project Name Count"
                }
              },
              "queryRef": "housing_sales.Project Name Count"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Locality concentration | verify Bengaluru geocoding'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ]
    }
  }
}
